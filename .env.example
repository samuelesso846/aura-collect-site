# --- serveur ---
PORT=8788
CABINET_NAME=Cabinet Lemaire & Associés
CABINET_PASSWORD=changez-ce-mot-de-passe
SESSION_SECRET=remplacez-par-32-caracteres-aleatoires
PUBLIC_BASE_URL=http://localhost:8788

# --- validation IA (Groq) ---
# Sans clé, les pièces sont stockées et marquées « à vérifier » : le cabinet tranche.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- emails (optionnel) ---
# Sans clé Resend, les emails sont journalisés dans data/db.json (outbox).
RESEND_API_KEY=
MAIL_FROM=Aura Collect <bonjour@auracollect.fr>

# --- base Supabase (Postgres, pooler) ---
DATABASE_URL=postgresql://aura_app.<project-ref>:<mot-de-passe>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
