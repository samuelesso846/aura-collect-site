# --- serveur ---
PORT=8788
CABINET_NAME=Cabinet Lemaire & Associés
CABINET_PASSWORD=changez-ce-mot-de-passe
SESSION_SECRET=remplacez-par-32-caracteres-aleatoires
PUBLIC_BASE_URL=http://localhost:8788

# --- validation IA (Groq) ---
# Sans clé, les pièces sont stockées et marquées « à vérifier » : le cabinet tranche.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- emails (optionnel) ---
# Sans clé Resend, les emails sont journalisés dans data/db.json (outbox).
RESEND_API_KEY=
MAIL_FROM=Aura Collect <bonjour@auracollect.fr>

# --- base Supabase (Postgres, pooler) ---
DATABASE_URL=postgresql://aura_app.<project-ref>:<mot-de-passe>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# --- stockage des pièces (Supabase Storage) ---
# Sans ces deux valeurs, les fichiers restent stockés en base (plafond 500 Mo).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=aura-files

# --- FedaPay (paiement des abonnements, devise XOF uniquement) ---
# live = clés sk_live_/pk_live_ ; sandbox = clés sk_sandbox_/pk_sandbox_
FEDAPAY_ENV=live
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
# Secret du point de terminaison, visible dans Dashboard → Webhooks → (votre endpoint) → Click to reveal
FEDAPAY_WEBHOOK_SECRET=

# --- facturation ---
# Email de facturation utilisé pour créer le client FedaPay (obligatoire pour payer).
CABINET_EMAIL=
# Essai offert à la création du cabinet, puis jours de grâce après échéance avant suspension.
BILLING_TRIAL_DAYS=7
BILLING_GRACE_DAYS=7
# Grille optionnelle : surcharge les montants par défaut (FCFA, sans centimes).
# PLAN_STARTER_PRICE=20000
# PLAN_PRO_PRICE=55000
# PLAN_CABINET_PRICE=130000
# PLAN_STARTER_ANNUAL=200000
# PLAN_PRO_ANNUAL=550000
# PLAN_CABINET_ANNUAL=1300000

# Adresse qui reçoit les demandes du formulaire de contact
CONTACT_TO=samuelesso846@gmail.com

# --- envoi d'emails (l'un des deux suffit) ---
# Option 1 : Resend, necessite un domaine verifie
RESEND_API_KEY=
MAIL_FROM="Aura Collect <bonjour@votredomaine.com>"
# Option 2 : SMTP Gmail, mot de passe d'application (compte avec validation en 2 etapes)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
